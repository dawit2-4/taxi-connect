// MockQueueRepositoryHandler is a mock implementation of QueueRepository for testing handlers
type MockQueueRepositoryHandler struct {
	mock.Mock
}

func (m *MockQueueRepositoryHandler) StoreReport(ctx context.Context, report queue.QueueReport) (uuid.UUID, error) {
	args := m.Called(ctx, report)
	return args.Get(0).(uuid.UUID), args.Error(1)
}

func (m *MockQueueRepositoryHandler) GetRecentReportsSince(ctx context.Context, fromID, toID uuid.UUID, cutoff time.Time) ([]queue.QueueReport, error) {
	args := m.Called(ctx, fromID, toID, cutoff)
	return args.Get(0).([]queue.QueueReport), args.Error(1)
}

